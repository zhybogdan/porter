{
  "name": "@porter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Porter HTTP API: NestJS over Postgres",
  "scripts": {
    "build": "nest build",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "catalog:",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@porter/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
