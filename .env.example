# Copy to .env and adjust. .env is git-ignored and never committed.
# These credentials are for the local container only: it listens on localhost
# and holds seeded demo data, nothing real.

POSTGRES_USER=porter
POSTGRES_PASSWORD=porter_local_dev
POSTGRES_DB=porter
POSTGRES_PORT=5432

# Read by the api and by Prisma. Host port, not the container one.
DATABASE_URL=postgresql://porter:porter_local_dev@localhost:5432/porter?schema=public

# Host port of the test database (docker compose profile "test").
POSTGRES_TEST_PORT=5433

# Size of the node-postgres pool. Raise it above the number of concurrent
# requests any race test fires, or the pool serialises them.
DATABASE_POOL_MAX=10

# Signs access tokens. Generate your own, never reuse this line:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters, enforced at boot.
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Access token lifetime in seconds. Short: it cannot be revoked.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds. 30 days; revocable through `sessions`.
REFRESH_TOKEN_TTL_SECONDS=2592000
