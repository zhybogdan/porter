{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "The body is the same in both answers and names the part that is down.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Everything answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Report whether the API and the database answer.",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new token pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Unknown email or wrong password; the two are not told apart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "The body failed validation; `errors` names the fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Exchange an email and a password for a token pair.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "The presented token stops working. Presenting one a second time is treated as a leak and revokes every token in its chain.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new token pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, expired or already used refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "The body failed validation; `errors` names the fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Exchange a refresh token for a new pair.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The token is revoked, or was revoked already"
          },
          "422": {
            "description": "The body failed validation; `errors` names the fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Revoke one refresh token.",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_profile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "summary": "The signed-in user, read from the database rather than from the token.",
        "tags": [
          "me"
        ]
      }
    },
    "/properties": {
      "get": {
        "operationId": "PropertiesController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Omit for the first page; otherwise the `nextCursor` of the page before.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "How many rows to return, at most 100.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of buildings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyPage"
                }
              }
            }
          },
          "400": {
            "description": "The cursor could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "A query parameter failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "summary": "The buildings of the caller's organization, newest first.",
        "tags": [
          "properties"
        ]
      },
      "post": {
        "operationId": "PropertiesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePropertyDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The building created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Signed in, but not as a manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "The body failed validation; `errors` names the fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "summary": "Add a building. Managers only.",
        "tags": [
          "properties"
        ]
      }
    },
    "/properties/{id}": {
      "get": {
        "operationId": "PropertiesController_byId",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The building",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a uuid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such building in the caller’s organization. Also the answer when it exists in another one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "summary": "One building by id.",
        "tags": [
          "properties"
        ]
      }
    }
  },
  "info": {
    "title": "Porter API",
    "description": "Maintenance requests and amenity booking for managed apartment buildings.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "description": "`degraded` whenever any check below is down.",
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          },
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since this process started, rounded."
          }
        },
        "required": [
          "status",
          "database",
          "uptimeSeconds"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Case-insensitive.",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Sent as typed; no normalisation and no minimum length.",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed JWT, sent as `Authorization: Bearer <token>` on every request."
          },
          "expiresIn": {
            "type": "number",
            "description": "Lifetime of the access token in seconds, so the client need not decode it."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque string, exchanged at `POST /auth/refresh` for the next pair."
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the field that failed, e.g. `unit.label`."
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI identifying the problem kind. `about:blank` means \"nothing beyond\nthe status code\", which is the honest answer for plain HTTP errors. A\nproblem that clients must handle specially gets its own URI, and that URI\nthen becomes part of the contract.",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Unauthorized"
          },
          "status": {
            "type": "number",
            "example": 401
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "The path that produced the problem.",
            "example": "/me"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The string handed out by login or by the previous refresh.",
            "maxLength": 128
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "manager",
          "technician",
          "resident"
        ],
        "description": "What this user is allowed to do."
      },
      "Profile": {
        "type": "object",
        "properties": {
          "role": {
            "description": "What this user is allowed to do.",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "orgId": {
            "type": "string",
            "description": "The organization this user belongs to: the tenant boundary."
          }
        },
        "required": [
          "role",
          "id",
          "email",
          "fullName",
          "orgId"
        ]
      },
      "Property": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone name, for example `Europe/Kyiv`."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Also the value of the `ETag` header on this resource."
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "timezone",
          "createdAt",
          "updatedAt"
        ]
      },
      "PropertyPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Property"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass back as `?cursor=` for the next page. Null on the last one, which is\nhow a client knows to stop -- rather than by seeing fewer rows than it\nasked for, which is also true of a full last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreatePropertyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "What the managers call this building: \"Riverside 12\".",
            "maxLength": 200
          },
          "address": {
            "type": "string",
            "description": "Free text, one line, as a courier would read it.",
            "maxLength": 500
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone name, for example `Europe/Kyiv`."
          }
        },
        "required": [
          "name",
          "address",
          "timezone"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
