# Editor defaults, so formatting does not depend on whose machine a file was
# last opened on. Paired with .gitattributes, which handles line endings in git.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 80

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
