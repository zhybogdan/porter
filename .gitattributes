# Normalise line endings: LF in the repository, native in the working copy.
# Development happens on Windows, CI and Docker run Linux: without this, shell
# scripts arrive with CRLF and fail to execute inside containers.
* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Generated and committed on purpose. linguist-generated collapses them in a
# pull request and keeps them out of the language statistics, so the
# repository reads as what was actually written.
#
# Deliberately NOT -diff. That flag stops git producing a textual diff at all,
# which defeats the reason these files are committed: a dependency change has
# to be reviewable in the lockfile, and a breaking API change has to be
# reviewable in openapi.json. Collapsed by default is wanted; unreadable is not.
pnpm-lock.yaml                  linguist-generated
packages/contract/openapi.json  linguist-generated
apps/mobile/lib/api/**          linguist-generated

# Binaries: never touched, never diffed.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.apk  binary
