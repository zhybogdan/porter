{
  "name": "porter",
  "private": true,
  "type": "module",
  "description": "Maintenance requests and amenity booking for managed apartment buildings",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter @porter/api exec eslint --fix"
  }
}
