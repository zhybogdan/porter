# Loaded by vitest, never by the running app. Points at the compose service
# `postgres-test`, which keeps its data in memory and gets truncated between
# tests.
POSTGRES_USER=porter
POSTGRES_PASSWORD=porter_local_dev
POSTGRES_DB=porter
POSTGRES_TEST_PORT=5433

DATABASE_URL=postgresql://porter:porter_local_dev@localhost:5433/porter?schema=public

# Above the largest N any race test fires, so the pool cannot serialise the
# requests and hide the race.
DATABASE_POOL_MAX=20

# Fixed for the suite. A short lifetime here would make expiry tests flaky.
JWT_SECRET=zz6UH_S_aQ2zdz4rudFr1z7WgGIt63eACSc9kUdpPVpG7Xh7I2oL_4wpnGSiHcpf
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
